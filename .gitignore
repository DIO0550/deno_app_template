# Deno
# https://deno.com/

# Cache directory (when using project-local DENO_DIR)
# https://docs.deno.com/runtime/fundamentals/setup/#deno_dir
.deno/

# Coverage reports
# https://docs.deno.com/runtime/reference/cli/coverage/
coverage/
*.lcov

# Compiled native binaries (deno compile)
dist/

# Vite ビルド成果物 (deno compile に同梱されるため commit 不要)
dist-web/

# Vite が必要とする node_modules (web/deno.json の nodeModulesDir: "auto" で生成)
web/node_modules/

# 注意: vendor/ / deno.lock / web/pnpm-lock.yaml はサプライチェーン固定のため必ずコミットする
